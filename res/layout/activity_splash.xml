<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:scaleType="centerInside"
            android:src="@drawable/transport_app_logo"
            android:contentDescription="Transport App Logo"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transport Cost Comparator"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDeveloperName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Developed by: Gomolemo Reggy Junior Selemela"
            android:textSize="18sp"
            android:gravity="center"/>

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:indeterminate="true" />

    </LinearLayout>
</RelativeLayout>