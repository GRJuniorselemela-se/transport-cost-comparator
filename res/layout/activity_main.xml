<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@color/white"
        tools:context=".MainActivity">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transport Cost Comparator"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome To the Transport Cost Comparator App"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnListenToMe"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Listen to Me"
            android:backgroundTint="@color/grey"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estimate your daily and monthly transport cost."
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnStartCalculation"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Start Calculation"
            android:backgroundTint="@color/grey"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Exit"
            android:backgroundTint="@color/grey" />

</LinearLayout>
